# Personal DIRECT priority. Preserve exact selectors from the existing Clash script.
# These domain rules also feed DNS policy, Fake-IP exclusions and sniff exclusions.
DOMAIN-SUFFIX,erp.lingxing.com,DIRECT
DOMAIN-SUFFIX,feishu.cn,DIRECT
DOMAIN-SUFFIX,feishu.net,DIRECT
DOMAIN-SUFFIX,larkoffice.com,DIRECT
DOMAIN-SUFFIX,feishucdn.com,DIRECT
DOMAIN-SUFFIX,ziniao.com,DIRECT
DOMAIN-SUFFIX,uuyc.163.com,DIRECT
DOMAIN-SUFFIX,uu.163.com,DIRECT
# Domestic ByteDance exceptions must precede TikTok.
DOMAIN-SUFFIX,snssdk.com,DIRECT
DOMAIN-SUFFIX,bytedapm.com,DIRECT
# A process DIRECT rule chooses its outbound; it does not bypass TUN capture.
PROCESS-NAME,Feishu.exe,DIRECT
PROCESS-NAME,Lark.exe,DIRECT
PROCESS-NAME,ziniao.exe,DIRECT
PROCESS-NAME,ziniaobrowser.exe,DIRECT
PROCESS-NAME,ziniao-gateway.exe,DIRECT
PROCESS-NAME,GameViewer.exe,DIRECT
PROCESS-NAME,GameViewerHealthd.exe,DIRECT
PROCESS-NAME,GameViewerServer.exe,DIRECT
PROCESS-NAME,GameViewerService.exe,DIRECT
PROCESS-NAME,biubiu.exe,DIRECT
PROCESS-NAME,bbupdate.exe,DIRECT
PROCESS-NAME,EpicSeven.exe,DIRECT
PROCESS-NAME,DQJL.exe,DIRECT

# PROXY is a build-time policy label, resolved to the provider's main selector.
PROCESS-NAME,Twitch Drops Miner (by DevilXD).exe,PROXY
PROCESS-NAME,Codex.exe,PROXY
# Intentional download priority; other GitHub domains belong to the upstream.
DOMAIN-SUFFIX,githubusercontent.com,PROXY
DOMAIN,cloudflare-dns.com,PROXY
DOMAIN,dns.google,PROXY
# Snow's previous TikTok collection included this endpoint; v2fly does not.
# Keep this narrow compatibility rule when retiring the provider's collection.
DOMAIN-SUFFIX,ipstatp.com,PROXY
# Copilot entry points must precede Microsoft DIRECT.
DOMAIN-SUFFIX,copilot.com,PROXY
DOMAIN-SUFFIX,copilot.cloud.microsoft,PROXY
